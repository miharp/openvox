<%- | String $label, String $plist, Integer $delay | -%>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Managed by Puppet (profile::puppet_launchd). One-shot job that reloads
     the agent's launchd job from outside the agent's process group. -->
<plist version="1.0">
<dict>
        <key>Label</key>
        <string><%= $label %></string>
        <key>ProgramArguments</key>
        <array>
                <string>/bin/sh</string>
                <string>-c</string>
                <!-- bootout returns before the agent has exited, and bootstrap
                     fails with "5: Input/output error" until the old job is
                     gone, so wait for it and retry. -->
                <string>sleep <%= $delay %>
/bin/launchctl bootout system/puppet
for i in $(seq 60); do /bin/launchctl print system/puppet 1&gt;/dev/null 2&gt;&amp;1 || break; sleep 1; done
for i in $(seq 10); do /bin/launchctl bootstrap system <%= $plist %> &amp;&amp; break; sleep 3; done
/bin/launchctl bootout system/<%= $label %></string>
        </array>
        <key>RunAtLoad</key>
        <true/>
        <key>StandardErrorPath</key>
        <string>/var/log/puppetlabs/puppet/puppet-reload.log</string>
        <key>StandardOutPath</key>
        <string>/var/log/puppetlabs/puppet/puppet-reload.log</string>
</dict>
</plist>
